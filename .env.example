# Copy to .env.local and fill in. Never commit .env.local.

# --- Chain -------------------------------------------------------------
# QuickNode Monad endpoints (HTTPS). Also used by forge scripts.
MONAD_TESTNET_RPC_URL=
MONAD_MAINNET_RPC_URL=
# Deployer private key for forge scripts (testnet only, fund with MON + testnet USDC)
DEPLOYER_PRIVATE_KEY=
NEXT_PUBLIC_CHAIN_ID=10143
# The two sites (testnet and mainnet) the navbar's network switch moves between. Defaults: local dev servers.
NEXT_PUBLIC_TESTNET_URL=http://localhost:3100
NEXT_PUBLIC_MAINNET_URL=http://localhost:3200
# Privy gas sponsorship for embedded wallets. Set to false when sponsorship is not enabled for the chain;
# users then pay gas in MON from their own wallet.
NEXT_PUBLIC_GAS_SPONSORED=true
# Bids, sweeps and auto-bid maximums at or above this many dollars ask for a passkey (Privy MFA).
NEXT_PUBLIC_STEP_UP_USD=1000

# --- Privy -------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=
# https://auth.privy.io/api/v1/apps/<APP_ID>/jwks.json — verifies Privy access tokens server-side
PRIVY_JWKS_URL=
PRIVY_APP_SECRET=
# Authorization key (Settings → Keys and quorums) that signs server-wallet requests
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Keeper: Privy server wallet limited by a Privy policy to closeBidding/release/markFailed on the market.
# Create with: node apps/web/scripts/privy-keeper-setup.mjs (then privy-keeper-wallet.mjs for an app-controlled wallet)
PRIVY_KEEPER_POLICY_ID=
PRIVY_SERVER_WALLET_ID=
KEEPER_ADDRESS=
# false = app-controlled wallet (app secret only); otherwise requests are signed with the authorization key
KEEPER_USES_AUTH_KEY=false
# false: the keeper wallet pays its own gas in MON (fund KEEPER_ADDRESS on that chain)
KEEPER_GAS_SPONSORED=true
# Auto-bid through Privy signers: the key quorum (wrapping the authorization key above) that brands add to their
# Patched wallet as a signer. Create once with: node apps/web/scripts/privy-signer-setup.mjs. Same id in both.
# Empty: Patched wallets fall back to the PatchAutoBidder contract like outside wallets.
PRIVY_SIGNER_QUORUM_ID=
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Bearer token the scheduler sends to /api/keeper/run
KEEPER_SECRET=
# The app server runs the keeper every minute by itself: on by default on testnet, set true to also do it on
# mainnet, false to turn it off (for example when an external cron calls /api/keeper/run).
KEEPER_AUTORUN=

# --- Supabase ----------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API keys (new-style)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct Postgres (pooler) for migrations and the indexer
DATABASE_URL=

# --- AI ----------------------------------------------------------------
# OpenRouter — the only AI provider (openrouter.ai/keys). Model ids can be swapped without code changes.
OPENROUTER_API_KEY=
AI_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
AI_IMAGE_FALLBACK_MODEL=google/gemini-2.5-flash-image
AI_VISION_MODEL=google/gemini-2.5-flash-lite


# UI tests (pnpm --filter web test:ui). Optional: a Privy test account (Privy dashboard → Authentication →
# Test accounts) turns on the signed-in tests. E2E_BASE_URL defaults to http://localhost:3000 (pnpm web:dev).
E2E_TEST_EMAIL=
E2E_TEST_CODE=
E2E_BASE_URL=

# "Try the demo account" on the sign-in page: a Privy test account's email and fixed code (Privy dashboard →
# Authentication → Test accounts). Falls back to E2E_TEST_EMAIL / E2E_TEST_CODE. Only offered while the site runs on
# play money (testnet, or mainnet on TestUSD), so the shared account never holds real USDC. DEMO_LOGIN=off hides it.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_CODE=
DEMO_LOGIN=

# The public site address, for link previews (e.g. https://patched.world). On Vercel it defaults to the production URL.
NEXT_PUBLIC_SITE_URL=

# Creator subdomains: with this set, dhruv.<HANDLE_DOMAIN> shows /dhruv and dhruv.<HANDLE_DOMAIN>/6 shows /dhruv/6,
# keeping that address. For one sign-in across subdomains, turn on Privy's HttpOnly cookies for the parent domain.
# Needs a wildcard domain (*.<HANDLE_DOMAIN>) on the host. Example: monad.patched.world
HANDLE_DOMAIN=
# Same value as HANDLE_DOMAIN, for the browser: Copy link and Share hand out https://<handle>.<domain>/6.
NEXT_PUBLIC_HANDLE_DOMAIN=

# Patch anyone on X: turns an X handle into its numeric id (Privy links X accounts by id). Optional: with a token the
# official X API is used; without one, the free public FxTwitter API (api.fxtwitter.com).
X_BEARER_TOKEN=

# Open admin (hackathon demo only): anyone signed in can approve listings, fast-track proofs, settle disputes and manage
# events, sent by a Privy server wallet limited by policy to those calls. Create with
# node apps/web/scripts/privy-open-admin-setup.mjs, grant the wallet ADMIN_ROLE, and set OPEN_ADMIN=false after judging.
# Only works on play money (testnet, or mainnet on TestUSD): on real USDC it stays off whatever this says.
# Even when on, nobody can fast-track their own listing or settle a dispute they are part of.
OPEN_ADMIN=false
NEXT_PUBLIC_OPEN_ADMIN=false
PRIVY_OPEN_ADMIN_WALLET_ID=
OPEN_ADMIN_ADDRESS=
