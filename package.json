{
  "name": "patched",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contracts:setup": "cd contracts && forge install foundry-rs/forge-std OpenZeppelin/openzeppelin-contracts@v5.4.0 --no-git",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "shared:abi": "node packages/shared/scripts/export-abi.mjs",
    "web:dev": "pnpm --filter web dev",
    "web:build": "pnpm --filter web build",
    "web:verify": "pnpm --filter web verify"
  }
}
