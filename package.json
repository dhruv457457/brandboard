{
  "name": "patched",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "contracts:setup": "cd contracts && forge install foundry-rs/forge-std OpenZeppelin/openzeppelin-contracts@v5.4.0 --no-git",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "shared:abi": "node packages/shared/scripts/export-abi.mjs",
    "web:dev": "pnpm --filter web exec cross-env NEXT_PUBLIC_STEP_UP_USD=25 next dev --turbopack",
    "web:dev:mainnet": "pnpm --filter web exec cross-env NEXT_PUBLIC_CHAIN_ID=143 NEXT_PUBLIC_GAS_SPONSORED=false KEEPER_GAS_SPONSORED=false NEXT_DIST_DIR=.next-mainnet next dev --turbopack -p 3200",
    "web:build": "pnpm --filter web build",
    "web:verify": "pnpm --filter web verify",
    "db:migrate": "node scripts/db-migrate.mjs",
    "indexer": "pnpm --filter @patched/indexer run run"
  },
  "devDependencies": {
    "postgres": "^3.4.9",
    "tsx": "^4.23.15"
  }
}
